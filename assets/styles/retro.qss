/* Oh My Desktop - only desktop-specific overrides; everything else uses the system theme */



QToolTip {
    background-color: #ffffe1;
    color: #000000;
    border: 1px solid #808080;
    padding: 2px;
    font-size: 8pt;
}

QWidget#DesktopWindow {
    background: transparent;
}

QWidget#DesktopScene {
    background: transparent;
}

